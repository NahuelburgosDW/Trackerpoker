# ═══════════════════════════════════════════
# Backend (Railway / local API)
# ═══════════════════════════════════════════

PORT=3001

# ID del Sheet maestro (URL: /spreadsheets/d/ESTE_ID/edit)
MASTER_SHEET_ID=

# Salt para hash de contraseñas (cambiá en producción)
AUTH_SALT=pokertracker-change-me-in-production

# Orígenes del frontend permitidos (CORS), separados por coma
# Ej: https://trackerpoker.vercel.app
FRONTEND_URL=http://localhost:5173

# Opción A — local: path al JSON de la service account
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Opción B — Railway: pegá el JSON completo en una sola línea
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ═══════════════════════════════════════════
# Frontend (Vercel / Vite)
# ═══════════════════════════════════════════

# Vacío en local → Vite proxy /api → localhost:3001
# En Vercel → URL pública de Railway (sin slash final)
# VITE_API_URL=http://localhost:3001
# VITE_API_URL=https://tu-api.up.railway.app

# Opcionales (casi no usados)
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=
