# ─── Backend (mini API → Google Sheet maestro) ───
PORT=3001

# ID del Sheet maestro (de la URL: /spreadsheets/d/ESTE_ID/edit)
MASTER_SHEET_ID=

# Service Account JSON (Google Cloud → IAM → Service Accounts → Keys)
# Compartí el Sheet maestro con el email de la service account (Editor)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Salt para hash de contraseñas (cambiá en producción)
AUTH_SALT=pokertracker-change-me-in-production

# ─── Frontend (opcional) ───
# VITE_GOOGLE_CLIENT_ID=   # solo si querés OAuth para leer Sheets de usuarios
# VITE_GOOGLE_API_KEY=     # perfiles públicos sin login
